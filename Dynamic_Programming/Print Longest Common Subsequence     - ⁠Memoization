string findLCS(int n, int m,string &s1, string &s2){
        vector<vector<int>>dp(n+1,vector<int>(m+1,-1));
        for(int i=0;i<n+1;i++){
            dp[i][0]=0;
        }
        for(int j=1;j<m+1;j++){
            dp[0][j]=0;
        }
		for(int i =1;i<n+1;i++){
            for(int j=1;j<m+1;j++){
                if(s1[i-1]==s2[j-1]){
                    dp[i][j]=1+dp[i-1][j-1];
                }
                else{
                    dp[i][j]=max(dp[i][j-1],dp[i-1][j]);
                }
            }
        }
		string ans="";
		int i=n;
		int j=m;
		while(i>0 && j>0){
			if(s1[i-1]==s2[j-1]){
				ans+=s1[i-1];
				i--;
				j--;
			}
			else{
			if(dp[i][j-1]>dp[i-1][j]){
				j--;
			}
			else{
				i--;
			}
		}    
}
reverse(ans.begin(),ans.end());
return ans;
}
