# Print Shortest Common Supersequence 
https://leetcode.com/problems/shortest-common-supersequence/
class Solution {
public:
    string LCS(string s1,string s2,int m,int n,vector<vector<int>>&dp){
        for(int i=0;i<m+1;i++){
            dp[i][0]=0;
        }
        for(int j=1;j<n+1;j++){
            dp[0][j]=0;
        }
        for(int i=1;i<m+1;i++){
            for(int j=1;j<n+1;j++){
                if(s1[i-1]==s2[j-1]){
                    dp[i][j]=1+dp[i-1][j-1];
                }
                else{
                    dp[i][j]=max(dp[i-1][j],dp[i][j-1]);
                }
            }
        }
        string s="";
        int i=m;
        int j=n;
        while(i>0 && j>0){
            if(s1[i-1]==s2[j-1]){
                s.push_back(s1[i-1]);
                i--;
                j--;
            }
            else{
                if(dp[i-1][j]>dp[i][j-1]){
                    s.push_back(s1[i-1]);
                    i--;
                }
                else{
                    s.push_back(s2[j-1]);
                    j--;
                }
            }
        }
        while(i>0){
            s.push_back(s1[i-1]);
            i--;
        }
        while(j>0){
            s.push_back(s2[j-1]);
            j--;
        }
        reverse(s.begin(),s.end());
        return s;
    }
    string shortestCommonSupersequence(string str1, string str2) {
        int m=str1.size();
        int n=str2.size();
        vector<vector<int>>dp(m+1,vector<int>(n+1,0));
        return  LCS(str1,str2,m,n,dp);
    }
};
